msgid "Login at $site_name"
msgstr "Accesso a $site_name"

#: loginizer-security/init.php:4490
msgid ""
"Hi,\n"
"\n"
"A login request was submitted for your account $email at :\n"
"$site_name - $site_url\n"
"\n"
"Login at $site_name by visiting this url :\n"
"$login_url\n"
"\n"
"If you have not requested for the Login URL, please ignore this email.\n"
"\n"
"Regards,\n"
"$site_name"
msgstr ""
"Ciao,\n"
"\n"
"È stata inviata una richiesta di accesso per il tuo account $email su :\n"
"$site_name - $site_url\n"
"\n"
"Accedi a $site_name visitando questo url :\n"
"$login_url\n"
"\n"
"Se non hai richiesto l'URL di accesso, ignora questa email.\n"
"\n"
"Cordiali saluti,\n"
"$site_name"

